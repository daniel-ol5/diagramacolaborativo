@startuml casos-de-uso-modelado
' Paquetes D y E - Modelado y trabajo sin conexion (RF-01, RF-05)
left to right direction

actor "Colaborador" as C
actor "Editor" as ED
actor "Propietario" as OW

rectangle "D. Modelado" {
  usecase "CU17 Modelar clases" as CU17
  usecase "CU18 Modelar atributos" as CU18
  usecase "CU19 Modelar metodos" as CU19
  usecase "CU20 Modelar relaciones" as CU20
  usecase "CU21 Organizar en paquetes" as CU21
  usecase "CU22 Alternar vista UML / ER" as CU22
}

rectangle "E. Trabajo sin conexion" {
  usecase "CU23 Modelar sin conexion" as CU23
  usecase "CU24 Sincronizar y\nreconciliar al reconectar" as CU24
}

ED --> CU17
ED --> CU18
ED --> CU19
ED --> CU20
ED --> CU21
C --> CU22
ED --> CU23
ED --> CU24
OW --> CU23

CU24 ..> CU23 : <<extend>>

note bottom of CU23
  Sin conexion el cliente **omite** la adquisicion
  de bloqueo (§8.4): la exclusion mutua no
  desaparece, se traslada al momento del rebase
end note

note bottom of CU19
  Servidor: implementado
  Interfaz web: pendiente
end note
@enduml
