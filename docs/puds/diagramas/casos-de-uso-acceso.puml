@startuml casos-de-uso-acceso
' Paquetes A y B - Acceso, proyectos y diagramas
left to right direction

actor "Visitante" as V
actor "Colaborador" as C
actor "Propietario" as OW
actor "Editor" as ED

C <|-- OW
C <|-- ED

rectangle "A. Gestion de acceso" {
  usecase "CU01 Registrar usuario" as CU01
  usecase "CU02 Iniciar sesion" as CU02
}

rectangle "B. Proyectos y diagramas" {
  usecase "CU03 Crear proyecto" as CU03
  usecase "CU04 Consultar mis proyectos" as CU04
  usecase "CU05 Crear diagrama" as CU05
  usecase "CU06 Consultar diagramas" as CU06
  usecase "CU07 Abrir diagrama" as CU07
}

V --> CU01
V --> CU02
C --> CU03
C --> CU04
OW --> CU05
ED --> CU05
C --> CU06
C --> CU07

note bottom of CU04
  Devuelve el rol propio en cada proyecto:
  sin eso la interfaz no sabe que botones dibujar
end note
@enduml
